<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Declare that the app supports Android Automotive OS hardware -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <!-- AAOS Vehicle Data Permissions -->
    <!-- Basic car information (e.g., make, model, fuel type) -->
    <uses-permission
        android:name="android.car.permission.CAR_INFO"
        tools:ignore="ProtectedPermissions" />

    <!-- Powertrain data (e.g., current gear, engine status) -->
    <uses-permission
        android:name="android.car.permission.CAR_POWERTRAIN"
        tools:ignore="ProtectedPermissions" />

    <!-- Speed sensor data -->
    <uses-permission
        android:name="android.car.permission.CAR_SPEED"
        tools:ignore="ProtectedPermissions" />

    <!-- Energy/EV stats (e.g., battery level, EV charging status) -->
    <uses-permission
        android:name="android.car.permission.CAR_ENERGY"
        tools:ignore="ProtectedPermissions" />

    <!-- Climate and HVAC controls -->
    <uses-permission
        android:name="android.car.permission.CAR_CLIMATE"
        tools:ignore="ProtectedPermissions" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <uses-library
            android:name="android.car"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>